<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DEFAULT: Monochrome -->
    <style name="Theme.AnEn" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mono_primary</item>
        <item name="colorSecondary">@color/mono_secondary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.AnEn.Cyan" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorSecondary">@color/cyan_secondary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.AnEn.Green" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorSecondary">@color/green_secondary</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.AnEn.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorSecondary">@color/light_secondary</item>
        <item name="colorOnPrimary">@color/light_text</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>